{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(npx --version)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(npx --version)",
      "Bash(grep -iE \"^\\(linkedin|instagram|github|mail|file-text\\)\\\\.mjs$\")",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000__TRACKED_VAR__)",
      "Bash(curl -s \"http://localhost:3000/api/spotify/now-playing\")",
      "Bash(curl -s \"http://localhost:3000/sitemap.xml\")",
      "Bash(curl -s \"http://localhost:3000/\" -o /tmp/home.html -w \"%{http_code}\\\\n\")",
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w '%{http_code} __TRACKED_VAR__\\\\n' http://localhost:3000__TRACKED_VAR__)",
      "Bash(awk '{print $9, $5}')",
      "Bash(npm run *)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri http://localhost:3000/garage -TimeoutSec 60 -UseBasicParsing; \"HTTP $\\($r.StatusCode\\) - length: $\\($r.Content.Length\\)\" } catch { \"ERROR: $_\" })",
      "PowerShell(Get-Content .next\\\\dev\\\\logs\\\\next-development.log -Tail 30 | ForEach-Object { if \\($_.Length -gt 300\\) { $_.Substring\\(0,300\\) + \"...\" } else { $_ } })"
    ]
  }
}
