# Spotify Web API — powers the "Off the Clock" now-playing / top-tracks tile.
# All optional: with these unset, the tile shows a quiet placeholder instead of
# erroring. See the README ("Environment variables") for the one-time
# refresh-token exchange. Copy this file to .env.local and fill in your values.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
